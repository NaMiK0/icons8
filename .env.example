# Пример окружения. Скопировать в .env и вписать свой ключ:
#   cp .env.example .env
#
# .env лежит в .gitignore и в репозиторий не попадает.
# Ключ читается только из окружения — в config.toml его быть не должно.

# Адрес API. У proxyAPI одна точка входа на все модели каталога, и запросы
# принимаются в формате OpenAI независимо от того, чья модель за ним стоит —
# Qwen, Claude или любая другая. Производителя выбирает имя модели ниже, а не
# адрес. Тем же протоколом говорят OpenRouter и локальная Ollama: чтобы сменить
# провайдера, достаточно поменять эти строки.
LLM_BASE_URL=https://api.proxyapi.ru/v1

# Ключ доступа.
LLM_API_KEY=

# Основная модель каждой стадии на один запуск. Запасные модели и
# постоянные значения — в config/config.toml, раздел [models]. Строку можно
# удалить: тогда берётся конфиг.
LLM_MODEL_CLASSIFY=qwen/qwen3.5-flash-02-23
LLM_MODEL_CLUSTER=qwen/qwen3.5-27b
LLM_MODEL_CONTENT=qwen/qwen3.5-27b
